{
  "manifest_version": 3,
  "name": "Reynard",
  "version": "__VERSION__",
  "description": "Right-click anything and download it with Reynard.",
  "key": "__KEY__",
  "minimum_chrome_version": "120",
  "icons": {
    "48": "icon.png",
    "96": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x-post.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": "icons/idle.png",
    "default_title": "Reynard",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
